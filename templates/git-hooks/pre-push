#!/bin/bash -p
# vault-guard-start
# Two checks, in order:
#   1. Every pushed commit not yet on any remote must carry a pass record, written when the
#      commit hooks passed it or by `guard.sh verify`. A cherry-pick, revert or scripted
#      commit runs no pre-commit hook and has none. One unrecorded commit refuses the whole
#      push, unless a human at a terminal overrides with QG_SKIP_REASON. Overrides logged
#      since the last push are printed.
#   2. Every pushed ref goes to `guard.sh release --use-pass`, which accepts a pass record that
#      `qg run push --ref` wrote for exactly this push, else runs the rows whose `on` cell names
#      that ref and exits 0 at once when none does. The push is refused when any ref is worse
#      than quality/baseline.tsv, or loosens that file against the remote ref's old tip, also
#      after an override of check 1.
#
# It reads EVERY stdin line before any exit. A hook that exits early leaves git
# writing into a closed pipe: the writer dies with 141 while the hook reports 0,
# so the push fails and nothing says why.
#
# GUARD_SHA is exported so guard.sh measures a detached worktree of the commit
# being pushed, not the working directory. Uncommitted edits cannot move the gate.

GUARD="__GUARD_SH__"
# The clean start (lib/qg-clean-env.sh): no caller variable, function or PATH entry reaches the
# gate. Stdin passes through the restart, so every ref line is still read below.
# shellcheck source=../../lib/qg-clean-env.sh
. "${GUARD%/bin/guard.sh}/lib/qg-clean-env.sh" 2>/dev/null || {
    cat >/dev/null
    printf 'vault-guard: %s has no lib/qg-clean-env.sh beside it; push refused rather than passed unchecked\n' "$GUARD" >&2
    exit 1
}
qg_clean_env QG_SKIP_REASON -- "$@"
set -uo pipefail

REMOTE_NAME="${1:-}"
ZERO='0000000000000000000000000000000000000000'

pushed=()
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "${remote_ref:-}" ] || continue
    pushed+=("${local_ref} ${local_sha} ${remote_ref} ${remote_sha:-}")
done

# shellcheck source=../../lib/guard-hook.sh
. "$(dirname "$GUARD")/../lib/guard-hook.sh" 2>/dev/null || {
    printf 'vault-guard: %s has no lib/guard-hook.sh beside it; push refused rather than passed unchecked\n' "$GUARD" >&2
    exit 1
}

shas=()
for line in "${pushed[@]}"; do
    read -r _ local_sha _ _ <<<"$line"
    [ "$local_sha" = "$ZERO" ] || shas+=("$local_sha")   # a branch deletion pushes no commit
done

if [ "${#shas[@]}" -gt 0 ]; then
    unrecorded="$(guard_push_unrecorded "${shas[@]}")"
    if [ -n "$unrecorded" ]; then
        printf '\nvault-guard: push refused, these commits never passed the commit gate:\n' >&2
        while IFS= read -r c; do
            printf '  %s\n' "$(git log -1 --format='%h %s' "$c" 2>/dev/null || printf '%s (cannot read)' "$c")" >&2
        done <<<"$unrecorded"
        printf '\nMeasure them and record the passes, then push again:\n  %s verify %s --not --remotes\n\n' \
            "$GUARD" "${shas[*]}" >&2
        guard_override_used "pre-push to ${REMOTE_NAME}: $(wc -l <<<"$unrecorded") unrecorded commits" push "${shas[@]}" || {
            printf 'A human at a terminal may pass these once: qg override --reason "<why>" --push <sha>, then push again.\n' >&2
            exit 1
        }
    fi
fi
guard_print_bypass_log

# Every pushed ref goes to the engine, each on its own commit; the rows' `on` cells decide what
# runs there. One refusal refuses the whole push.
gated=()
declare -A queued=()
for line in "${pushed[@]}"; do
    read -r _ local_sha remote_ref remote_sha <<<"$line"
    [ "$local_sha" = "$ZERO" ] && continue        # a branch deletion measures nothing
    [ -z "${queued["$remote_ref $local_sha"]:-}" ] || continue
    queued["$remote_ref $local_sha"]=1
    gated+=("${remote_ref} ${local_sha} ${remote_sha:-}")
done

[ "${#gated[@]}" -gt 0 ] || exit 0

[ -x "$GUARD" ] || {
    printf 'vault-guard: %s is not executable — push refused rather than passed unmeasured\n' "$GUARD" >&2
    exit 1
}

status=0
for line in "${gated[@]}"; do
    read -r gated_ref gated_sha remote_sha <<<"$line"
    # --use-pass accepts a pass `qg run push --ref` recorded for exactly this push. It goes before
    # the ref, so an engine that predates it refuses the flag rather than reading it as the ref.
    GUARD_SHA="$gated_sha" GUARD_BASE="$(guard_baseline_base "$gated_sha" "$remote_sha")" "$GUARD" release --use-pass "$gated_ref" || status=1
done
[ "$status" -eq 0 ] || printf 'vault-guard: push refused. What failed and how to pass: qg last   (all commands: qg help)\n' >&2
exit "$status"
# vault-guard-end
