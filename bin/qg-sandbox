#!/usr/bin/python3 -I
"""qg-sandbox: run one command so it cannot write outside its grants nor open a Unix socket.

usage: qg-sandbox [--write <absolute path>]... [--armed <file>] [--max-abi <n>] [--keep-session] -- <argv...>

Landlock limits writes to the --write paths: a folder gets every handled right, a file gets write
and truncate. It also scopes signals and abstract Unix sockets to the sandbox. A seccomp filter
kills a call through a foreign architecture entry, returns ENOSYS for x32 numbers and io_uring_setup,
and returns EACCES for socket(AF_UNIX). Reads and TCP stay open.

Before the rules apply the process starts its own session, reads stdin from /dev/null and closes
every descriptor above 2. --armed <file> is written just before execvp. A run that cannot arm exits
125 with one stderr line and never writes the marker; lib/qg-sandbox.sh reads its absence as a
failure. --keep-session skips setsid, for a caller that already started the session and kills its
process group after the run, such as a runner. --max-abi lowers the Landlock ABI, for tests. Rules:
vault/plans/2026-10-20-1022-qg-s6-agent-hooks.rules.md, section "Sandbox".
"""
import ctypes
import os
import platform
import stat
import struct
import sys

ABI_MIN = 6
ARCHES = {  # machine -> (AUDIT_ARCH_*, socket syscall number)
    "x86_64": (0xC000003E, 41),
    "aarch64": (0xC00000B7, 198),
}
NR_CREATE_RULESET, NR_ADD_RULE, NR_RESTRICT_SELF = 444, 445, 446
NR_IO_URING_SETUP = 425
X32_BIT = 0x40000000
AF_UNIX = 1
ENOSYS, EACCES = 38, 13

# LANDLOCK_ACCESS_FS_*: every right that changes the file system. Reads and execution are not handled.
FS_WRITE_FILE = 1 << 1
FS_TRUNCATE = 1 << 14
FS_HANDLED = FS_WRITE_FILE | sum(1 << b for b in range(4, 15))  # remove, make_*, refer, truncate
FS_FILE = FS_WRITE_FILE | FS_TRUNCATE
SCOPE_ABSTRACT_UNIX_SOCKET, SCOPE_SIGNAL = 1 << 0, 1 << 1
CREATE_RULESET_VERSION = 1
RULE_PATH_BENEATH = 1

PR_SET_SECCOMP, SECCOMP_MODE_FILTER, PR_SET_NO_NEW_PRIVS = 22, 2, 38
RET_KILL_PROCESS, RET_ERRNO, RET_ALLOW = 0x80000000, 0x00050000, 0x7FFF0000
LD_W_ABS, JEQ_K, JGE_K, RET_K = 0x20, 0x15, 0x35, 0x06

KEEP_SESSION = False
libc = ctypes.CDLL(None, use_errno=True)
libc.syscall.restype = ctypes.c_long


def die(msg):
    print(f"qg-sandbox: {msg}", file=sys.stderr)
    sys.exit(125)


def syscall(nr, *args):
    rc = libc.syscall(ctypes.c_long(nr), *args)
    if rc < 0:
        return -ctypes.get_errno()
    return rc


def parse(argv):
    global KEEP_SESSION
    writes, armed, max_abi, i = [], None, None, 0
    while i < len(argv):
        a = argv[i]
        if a == "--keep-session":
            KEEP_SESSION, i = True, i + 1
            continue
        if a == "--":
            return writes, armed, max_abi, argv[i + 1:]
        if a in ("--write", "--armed", "--max-abi") and i + 1 < len(argv):
            v = argv[i + 1]
            if a == "--write":
                writes.append(v)
            elif a == "--armed":
                armed = v
            elif v.isdigit():
                max_abi = int(v)
            else:
                die(f"--max-abi {v} is not a number")
            i += 2
            continue
        die(f"unknown argument {a}")
    die("no command after --")


def isolate():
    for name in os.listdir("/proc/self/fd"):
        if int(name) > 2:
            try:
                os.close(int(name))
            except OSError:
                pass
    null = os.open("/dev/null", os.O_RDONLY)
    os.dup2(null, 0)
    os.close(null)
    if KEEP_SESSION:
        return
    try:
        os.setsid()
    except PermissionError:
        # A process group leader cannot start a session: run on in a child that can.
        pid = os.fork()
        if pid:
            code = os.waitstatus_to_exitcode(os.waitpid(pid, 0)[1])
            sys.exit(code if code >= 0 else 128 - code)
        os.setsid()


def landlock(writes, max_abi):
    abi = syscall(NR_CREATE_RULESET, None, ctypes.c_size_t(0), ctypes.c_uint32(CREATE_RULESET_VERSION))
    if abi < 0:
        die(f"Landlock is not available (errno {-abi})")
    if max_abi is not None:
        abi = min(abi, max_abi)
    if abi < ABI_MIN:
        die(f"Landlock ABI {abi} is below {ABI_MIN}")
    attr = ctypes.create_string_buffer(struct.pack("<QQQ", FS_HANDLED, 0, SCOPE_ABSTRACT_UNIX_SOCKET | SCOPE_SIGNAL))
    rfd = syscall(NR_CREATE_RULESET, attr, ctypes.c_size_t(24), ctypes.c_uint32(0))
    if rfd < 0:
        die(f"landlock_create_ruleset failed (errno {-rfd})")
    for path in writes:
        if not os.path.isabs(path) or os.path.normpath(path) != path:
            die(f"grant {path} is not a normalised absolute path")
        try:
            fd = os.open(path, os.O_PATH | os.O_NOFOLLOW | os.O_CLOEXEC)
        except OSError as e:
            die(f"grant {path} cannot be opened: {e.strerror}")
        st = os.fstat(fd)
        if stat.S_ISLNK(st.st_mode) or os.readlink(f"/proc/self/fd/{fd}") != path:
            die(f"grant {path} is or passes through a symlink")
        rule = ctypes.create_string_buffer(struct.pack("<Qi", FS_HANDLED if stat.S_ISDIR(st.st_mode) else FS_FILE, fd))
        rc = syscall(NR_ADD_RULE, ctypes.c_long(rfd), ctypes.c_long(RULE_PATH_BENEATH), rule, ctypes.c_uint32(0))
        if rc < 0:
            die(f"grant {path} was refused by Landlock (errno {-rc})")
        os.close(fd)
    if libc.prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0:
        die("PR_SET_NO_NEW_PRIVS failed")
    rc = syscall(NR_RESTRICT_SELF, ctypes.c_long(rfd), ctypes.c_uint32(0))
    if rc < 0:
        die(f"landlock_restrict_self failed (errno {-rc})")
    os.close(rfd)


def seccomp(audit_arch, nr_socket):
    def ins(code, jt, jf, k):
        return struct.pack("HBBI", code, jt, jf, k)
    prog = b"".join([
        ins(LD_W_ABS, 0, 0, 4),                       # seccomp_data.arch
        ins(JEQ_K, 1, 0, audit_arch),
        ins(RET_K, 0, 0, RET_KILL_PROCESS),           # a 32-bit or other foreign entry
        ins(LD_W_ABS, 0, 0, 0),                       # seccomp_data.nr
        ins(JGE_K, 0, 1, X32_BIT),
        ins(RET_K, 0, 0, RET_ERRNO | ENOSYS),         # x32 numbers
        ins(JEQ_K, 0, 1, NR_IO_URING_SETUP),
        ins(RET_K, 0, 0, RET_ERRNO | ENOSYS),
        ins(JEQ_K, 0, 3, nr_socket),
        ins(LD_W_ABS, 0, 0, 16),                      # low 32 bits of args[0], the family
        ins(JEQ_K, 0, 1, AF_UNIX),
        ins(RET_K, 0, 0, RET_ERRNO | EACCES),
        ins(RET_K, 0, 0, RET_ALLOW),
    ])

    class Fprog(ctypes.Structure):
        _fields_ = [("len", ctypes.c_ushort), ("filter", ctypes.c_void_p)]

    buf = ctypes.create_string_buffer(prog)
    fprog = Fprog(len(prog) // 8, ctypes.addressof(buf))
    if libc.prctl(PR_SET_SECCOMP, SECCOMP_MODE_FILTER, ctypes.byref(fprog), 0, 0) != 0:
        die(f"seccomp filter refused (errno {ctypes.get_errno()})")


def main():
    writes, armed, max_abi, cmd = parse(sys.argv[1:])
    if not cmd:
        die("no command after --")
    arch = ARCHES.get(platform.machine())
    if arch is None:
        die(f"architecture {platform.machine()} is not supported")
    isolate()
    landlock(writes, max_abi)
    seccomp(*arch)
    if armed:
        try:
            fd = os.open(armed, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
            os.write(fd, b"armed\n")
            os.close(fd)
        except OSError as e:
            die(f"cannot write the armed marker {armed}: {e.strerror}")
    try:
        os.execvp(cmd[0], cmd)
    except OSError as e:
        print(f"qg-sandbox: cannot run {cmd[0]}: {e.strerror}", file=sys.stderr)
        sys.exit(127)


main()
