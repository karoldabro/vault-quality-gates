#!/usr/bin/python3 -I
"""qg-sandbox: run one command so it cannot write outside its grants nor open a Unix socket.

usage: qg-sandbox [--write <absolute path>]... [--tree <folder> --declared <relative folder>...]
                  [--armed <file>] [--max-abi <n>] [--keep-session] -- <argv...>

Landlock limits writes to the --write paths: a folder gets every handled right, a file gets write
and truncate. It also scopes signals and abstract Unix sockets to the sandbox. A seccomp filter
kills a call through a foreign architecture entry; returns ENOSYS for x32 numbers and io_uring_setup;
returns EPERM for the chown family, file_setattr, and setting or removing an extended attribute;
returns EACCES for socket(AF_UNIX) and for a socketpair that is not SOCK_STREAM. Reads, TCP, chmod,
utime and the attribute ioctls stay open.

A --write path that is missing, a symlink, reached through one, or a file with more than one link
refuses the run. A --declared folder, relative to --tree, is resolved when the sandbox arms, after a
runner prepared the tree: each missing component is created as a folder, and a path reached through
a symlink, or one that is not a folder, is skipped with a stderr line. The tool runs in a nested
Landlock domain that holds only the scopes, so it cannot signal or ptrace this process.

Before the rules apply the process starts its own session (unless --keep-session: the caller already
did and kills its process group), reads stdin from /dev/null and closes every descriptor above 2. It
then becomes a child subreaper, writes the --armed marker, runs the command as its child, and, when
the child exits, kills every descendant left and exits with the child's status (128 + signal for a
signal). A run that cannot arm exits 125 with one stderr line and never writes the marker;
lib/qg-sandbox.sh reads its absence as a failure. --max-abi lowers the Landlock ABI, for tests.
Rules: vault/architecture/qg-sandbox.md.
"""
import ctypes
import os
import platform
import signal
import stat
import struct
import sys

ABI_MIN = 6
# machine -> AUDIT_ARCH_*, socket, socketpair, and the calls that change ownership or extended attributes.
ARCHES = {
    "x86_64": dict(arch=0xC000003E, socket=41, socketpair=53,
                   eperm=[92, 93, 94, 260,                  # chown, fchown, lchown, fchownat
                          188, 189, 190, 197, 198, 199,     # set/remove xattr, l-, f- forms
                          463, 466, 469]),                  # setxattrat, removexattrat, file_setattr
    "aarch64": dict(arch=0xC00000B7, socket=198, socketpair=199,
                    eperm=[54, 55,                          # fchownat, fchown
                           5, 6, 7, 14, 15, 16,             # set/remove xattr, l-, f- forms
                           463, 466, 469]),                 # setxattrat, removexattrat, file_setattr
}
NR_CREATE_RULESET, NR_ADD_RULE, NR_RESTRICT_SELF = 444, 445, 446
NR_IO_URING_SETUP = 425
X32_BIT = 0x40000000
AF_UNIX, SOCK_STREAM, SOCK_FLAGS = 1, 1, 0o2000000 | 0o4000  # SOCK_CLOEXEC | SOCK_NONBLOCK
EPERM, EACCES, ENOSYS = 1, 13, 38

# LANDLOCK_ACCESS_FS_*: every right that changes the file system. Reads and execution are not handled.
FS_WRITE_FILE = 1 << 1
FS_TRUNCATE = 1 << 14
FS_HANDLED = FS_WRITE_FILE | sum(1 << b for b in range(4, 15))  # remove, make_*, refer, truncate
FS_FILE = FS_WRITE_FILE | FS_TRUNCATE
SCOPE_ABSTRACT_UNIX_SOCKET, SCOPE_SIGNAL = 1 << 0, 1 << 1
CREATE_RULESET_VERSION = 1
RULE_PATH_BENEATH = 1

PR_SET_SECCOMP, SECCOMP_MODE_FILTER, PR_SET_NO_NEW_PRIVS, PR_SET_CHILD_SUBREAPER = 22, 2, 38, 36
RET_KILL_PROCESS, RET_ERRNO, RET_ALLOW = 0x80000000, 0x00050000, 0x7FFF0000
LD_W_ABS, JEQ_K, JGE_K, AND_K, RET_K = 0x20, 0x15, 0x35, 0x54, 0x06

KEEP_SESSION = False
libc = ctypes.CDLL(None, use_errno=True)
libc.syscall.restype = ctypes.c_long


def die(msg):
    print(f"qg-sandbox: {msg}", file=sys.stderr)
    sys.exit(125)


def syscall(nr, *args):
    rc = libc.syscall(ctypes.c_long(nr), *args)
    if rc < 0:
        return -ctypes.get_errno()
    return rc


def parse(argv):
    global KEEP_SESSION
    writes, declared, armed, max_abi, i = [], [], None, None, 0
    tree = None
    while i < len(argv):
        a = argv[i]
        if a == "--keep-session":
            KEEP_SESSION, i = True, i + 1
            continue
        if a == "--":
            if declared and tree is None:
                die("--declared needs --tree")
            return writes, [(tree, d) for d in declared], armed, max_abi, argv[i + 1:]
        if a in ("--write", "--declared", "--tree", "--armed", "--max-abi") and i + 1 < len(argv):
            v = argv[i + 1]
            if a == "--write":
                writes.append(v)
            elif a == "--declared":
                declared.append(v)
            elif a == "--tree":
                tree = v
            elif a == "--armed":
                armed = v
            elif v.isdigit():
                max_abi = int(v)
            else:
                die(f"--max-abi {v} is not a number")
            i += 2
            continue
        die(f"unknown argument {a}")
    die("no command after --")


def isolate():
    for name in os.listdir("/proc/self/fd"):
        if int(name) > 2:
            try:
                os.close(int(name))
            except OSError:
                pass
    null = os.open("/dev/null", os.O_RDONLY)
    os.dup2(null, 0)
    os.close(null)
    if KEEP_SESSION:
        return
    try:
        os.setsid()
    except PermissionError:
        # A process group leader cannot start a session: run on in a child that can.
        pid = os.fork()
        if pid:
            sys.exit(exit_code(os.waitpid(pid, 0)[1]))
        os.setsid()


def exit_code(status):
    code = os.waitstatus_to_exitcode(status)
    return code if code >= 0 else 128 - code


def open_grant(path):
    """-> (fd, stat) of a path whose every component is real, or (None, reason)."""
    if not os.path.isabs(path) or os.path.normpath(path) != path:
        return None, "is not a normalised absolute path"
    try:
        fd = os.open(path, os.O_PATH | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError as e:
        return None, f"cannot be opened: {e.strerror}"
    st = os.fstat(fd)
    if stat.S_ISLNK(st.st_mode) or os.readlink(f"/proc/self/fd/{fd}") != path:
        os.close(fd)
        return None, "is or passes through a symlink"
    return fd, st


def open_declared(tree, rel):
    """-> (fd, None) of the folder <tree>/<rel>, each missing component created as a folder; or
    (None, reason) when a component is a symlink or not a folder, or a component cannot be made."""
    fd, st = open_grant(tree)
    if fd is None:
        return None, f"has a tree that {st}"
    for comp in rel.split("/"):
        if comp in ("", ".", "..") or not stat.S_ISDIR(os.fstat(fd).st_mode):
            os.close(fd)
            return None, "is not a plain path of folders"
        try:
            nfd = os.open(comp, os.O_PATH | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
        except FileNotFoundError:
            try:
                os.mkdir(comp, 0o755, dir_fd=fd)
                nfd = os.open(comp, os.O_PATH | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
            except OSError as e:
                os.close(fd)
                return None, f"cannot be created: {e.strerror}"
        except OSError as e:
            os.close(fd)
            return None, f"cannot be opened: {e.strerror}"
        os.close(fd)
        fd = nfd
        st = os.fstat(fd)
        if stat.S_ISLNK(st.st_mode):
            os.close(fd)
            return None, "is reached through a symlink"
    if not stat.S_ISDIR(os.fstat(fd).st_mode):
        os.close(fd)
        return None, "is not a folder"
    return fd, None


def add_rule(rfd, path, fd, access):
    rule = ctypes.create_string_buffer(struct.pack("<Qi", access, fd))
    rc = syscall(NR_ADD_RULE, ctypes.c_long(rfd), ctypes.c_long(RULE_PATH_BENEATH), rule, ctypes.c_uint32(0))
    os.close(fd)
    if rc < 0:
        die(f"grant {path} was refused by Landlock (errno {-rc})")


def landlock(writes, declared, max_abi):
    abi = syscall(NR_CREATE_RULESET, None, ctypes.c_size_t(0), ctypes.c_uint32(CREATE_RULESET_VERSION))
    if abi < 0:
        die(f"Landlock is not available (errno {-abi})")
    if max_abi is not None:
        abi = min(abi, max_abi)
    if abi < ABI_MIN:
        die(f"Landlock ABI {abi} is below {ABI_MIN}")
    attr = ctypes.create_string_buffer(struct.pack("<QQQ", FS_HANDLED, 0, SCOPE_ABSTRACT_UNIX_SOCKET | SCOPE_SIGNAL))
    rfd = syscall(NR_CREATE_RULESET, attr, ctypes.c_size_t(24), ctypes.c_uint32(0))
    if rfd < 0:
        die(f"landlock_create_ruleset failed (errno {-rfd})")
    for path in writes:
        fd, st = open_grant(path)
        if fd is None:
            die(f"grant {path} {st}")
        if stat.S_ISDIR(st.st_mode):
            add_rule(rfd, path, fd, FS_HANDLED)
        elif st.st_nlink > 1:
            os.close(fd)
            die(f"grant {path} is a file with {st.st_nlink} links")
        else:
            add_rule(rfd, path, fd, FS_FILE)
    for tree, rel in declared:
        fd, why = open_declared(tree, rel)
        if fd is None:
            print(f"qg-sandbox: declared path {tree}/{rel} {why}; not writable", file=sys.stderr)
            continue
        add_rule(rfd, f"{tree}/{rel}", fd, FS_HANDLED)
    if libc.prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0:
        die("PR_SET_NO_NEW_PRIVS failed")
    rc = syscall(NR_RESTRICT_SELF, ctypes.c_long(rfd), ctypes.c_uint32(0))
    if rc < 0:
        die(f"landlock_restrict_self failed (errno {-rc})")
    os.close(rfd)


def seccomp(arch):
    def ins(code, jt, jf, k):
        return struct.pack("HBBI", code, jt, jf, k)
    prog = [
        ins(LD_W_ABS, 0, 0, 4),                       # seccomp_data.arch
        ins(JEQ_K, 1, 0, arch["arch"]),
        ins(RET_K, 0, 0, RET_KILL_PROCESS),           # a 32-bit or other foreign entry
        ins(LD_W_ABS, 0, 0, 0),                       # seccomp_data.nr
        ins(JGE_K, 0, 1, X32_BIT),
        ins(RET_K, 0, 0, RET_ERRNO | ENOSYS),         # x32 numbers
        ins(JEQ_K, 0, 1, NR_IO_URING_SETUP),
        ins(RET_K, 0, 0, RET_ERRNO | ENOSYS),
    ]
    for nr in arch["eperm"]:
        prog += [ins(JEQ_K, 0, 1, nr), ins(RET_K, 0, 0, RET_ERRNO | EPERM)]
    prog += [
        ins(JEQ_K, 0, 3, arch["socketpair"]),
        ins(LD_W_ABS, 0, 0, 24),                      # low 32 bits of args[1], the type
        ins(AND_K, 0, 0, 0xFFFFFFFF & ~SOCK_FLAGS),
        ins(JEQ_K, 4, 3, SOCK_STREAM),                # stream: allow; any other type: EACCES
        ins(JEQ_K, 0, 3, arch["socket"]),
        ins(LD_W_ABS, 0, 0, 16),                      # low 32 bits of args[0], the family
        ins(JEQ_K, 0, 1, AF_UNIX),
        ins(RET_K, 0, 0, RET_ERRNO | EACCES),
        ins(RET_K, 0, 0, RET_ALLOW),
    ]
    prog = b"".join(prog)

    class Fprog(ctypes.Structure):
        _fields_ = [("len", ctypes.c_ushort), ("filter", ctypes.c_void_p)]

    buf = ctypes.create_string_buffer(prog)
    fprog = Fprog(len(prog) // 8, ctypes.addressof(buf))
    if libc.prctl(PR_SET_SECCOMP, SECCOMP_MODE_FILTER, ctypes.byref(fprog), 0, 0) != 0:
        die(f"seccomp filter refused (errno {ctypes.get_errno()})")


def descendants_of(me):
    """-> the pids whose parent is `me`; a subreaper inherits every orphaned descendant."""
    kids = []
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        try:
            with open(f"/proc/{name}/stat") as f:
                fields = f.read().rsplit(")", 1)[1].split()
        except OSError:
            continue
        if int(fields[1]) == me:
            kids.append(int(name))
    return kids


def run(cmd):
    child = os.fork()
    if child == 0:
        # A nested domain with only the scopes: the tool can neither signal nor ptrace this parent,
        # which must outlive it to kill what it leaves behind.
        attr = ctypes.create_string_buffer(struct.pack("<QQQ", 0, 0, SCOPE_ABSTRACT_UNIX_SOCKET | SCOPE_SIGNAL))
        rfd = syscall(NR_CREATE_RULESET, attr, ctypes.c_size_t(24), ctypes.c_uint32(0))
        if rfd < 0 or syscall(NR_RESTRICT_SELF, ctypes.c_long(rfd), ctypes.c_uint32(0)) < 0:
            print("qg-sandbox: cannot scope the tool away from its parent", file=sys.stderr)
            os._exit(126)
        os.close(rfd)
        try:
            os.execvp(cmd[0], cmd)
        except OSError as e:
            print(f"qg-sandbox: cannot run {cmd[0]}: {e.strerror}", file=sys.stderr)
        os._exit(127)
    reaped = []

    def forward(sig, _frame):
        if reaped:
            return
        try:
            os.kill(child, sig)
        except OSError:
            pass

    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, forward)
    while True:
        try:
            pid, status = os.waitpid(child, 0)
            break
        except InterruptedError:
            continue
    reaped.append(child)
    code = exit_code(status)
    # Kill what the tool left, including a process that started its own session; each orphan of a
    # killed process becomes this process's child, so repeat until none is left.
    me = os.getpid()
    while True:
        for pid in descendants_of(me):
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
        try:
            os.waitpid(-1, 0)
        except ChildProcessError:
            break
    sys.exit(code)


def main():
    writes, declared, armed, max_abi, cmd = parse(sys.argv[1:])
    if not cmd:
        die("no command after --")
    arch = ARCHES.get(platform.machine())
    if arch is None:
        die(f"architecture {platform.machine()} is not supported")
    isolate()
    landlock(writes, declared, max_abi)
    seccomp(arch)
    if libc.prctl(PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0) != 0:
        die("PR_SET_CHILD_SUBREAPER failed")
    if armed:
        try:
            fd = os.open(armed, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
            os.write(fd, b"armed\n")
            os.close(fd)
        except OSError as e:
            die(f"cannot write the armed marker {armed}: {e.strerror}")
    run(cmd)


main()
