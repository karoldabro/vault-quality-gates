#!/usr/bin/env bats
# drivers/dart-lock.sh — packages whose pubspec.lock entry a commit changed that it may not change
# itself. Both sides are read from git: the base commit(s) in QG_BASES and QG_TARGET (:index is the
# index). No tool runs. The lock below copies pub's block form: hosted with sha256 and url, sdk, path
# and git with resolved-ref.

load guard-helpers

ROOT=/code
DRIVER="$ROOT/drivers/dart-lock.sh"
NAMED='packages=dart_code_linter,lakos,mutation_test,flutter_lints'

LOCK='# Generated by pub
# See https://dart.dev/tools/pub/glossary#lockfile
packages:
  args:
    dependency: transitive
    description:
      name: args
      sha256: "d0481093c50b1da8910eb0bb301626d4d8eb7284aa739614d2b394ee09e3ea04"
      url: "https://pub.dev"
    source: hosted
    version: "2.7.0"
  dart_code_linter:
    dependency: "direct dev"
    description:
      name: dart_code_linter
      sha256: "3c5e1f2a9b8d7c6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e"
      url: "https://pub.dev"
    source: hosted
    version: "1.1.5"
  flutter:
    dependency: "direct main"
    description: flutter
    source: sdk
    version: "0.0.0"
  givore_lints:
    dependency: "direct dev"
    description:
      path: "tool/givore_lints"
      relative: true
    source: path
    version: "1.0.0"
  lakos:
    dependency: "direct dev"
    description:
      name: lakos
      sha256: "8a1d3f7c2e9b4a6d0c5e8f1b3a7d9c2e4f6a8b0d1c3e5f7a9b2d4c6e8f0a1b3c"
      url: "https://pub.dev"
    source: hosted
    version: "2.0.6"
  mutation_test:
    dependency: "direct dev"
    description:
      path: "."
      ref: main
      resolved-ref: "5f2c8a1e9b3d7c6a4e2f0b8d6c4a2e0f8b6d4c2a"
      url: "https://github.com/domohuhn/mutation_test.git"
    source: git
    version: "1.8.0"
  path:
    dependency: transitive
    description:
      name: path
      sha256: "75cca69d1490965be98c73ceaea117e8a04dd21217b37b292c9ddbec0d955bc5"
      url: "https://pub.dev"
    source: hosted
    version: "1.9.1"
sdks:
  dart: ">=3.5.0 <4.0.0"
  flutter: ">=3.24.0"
'

SPEC='name: givore
environment:
  sdk: ">=3.5.0 <4.0.0"
dependencies:
  flutter:
    sdk: flutter
dev_dependencies:
  dart_code_linter: 1.1.5
  lakos: 2.0.6
'

setup() {
    export LC_ALL=C
    WORK="$(mktemp -d)"
    unset QG_RUNNER QG_ARGS QG_RUN_DIR QG_BASE QG_TREE CLAUDECODE AI_AGENT
    mkdir -p "$WORK/out"
    REPO="$WORK/repo"
    new_repo "$REPO"
    printf '%s' "$LOCK" > pubspec.lock
    printf '%s' "$SPEC" > pubspec.yaml
    commit_all base
    BASE="$(git rev-parse HEAD)"
    export QG_REPO="$REPO" QG_OUT="$WORK/out" QG_ROW=dart-lock-row QG_TARGET=:index QG_BASES="$BASE" QG_ARGS="$NAMED"
}

teardown() {
    [ -n "${WORK:-}" ]
    [ -d "$WORK" ] && rm -rf "$WORK"
    return 0
}

result() { jq -r "$1" "$QG_OUT/result.json"; }
measure() { rm -f "$QG_OUT/result.json"; "$DRIVER" run > /dev/null; }

# edit <sed script> [file] -> rewrites the file (default pubspec.lock) in the repo and stages it.
edit() {
    sed -i "$1" "$REPO/${2:-pubspec.lock}"
    git -C "$REPO" add -A
}

# block <name> <source> <version> [description lines] -> one lock entry in block form.
block() {
    printf '  %s:\n    dependency: transitive\n    description:\n%s\n    source: %s\n    version: "%s"\n' \
        "$1" "${4:-      name: $1
      url: \"https://pub.dev\"}" "$2" "$3"
}

# insert_before <entry name> <entry text> -> adds an entry above that package's block and stages it.
insert_before() {
    awk -v n="  $1:" -v add="$2" '$0 == n { print add } { print }' "$REPO/pubspec.lock" > "$WORK/lock.new"
    mv "$WORK/lock.new" "$REPO/pubspec.lock"
    git -C "$REPO" add -A
}

# replace_entry <name> <new entry text> -> swaps that package's block in pubspec.lock and stages it.
replace_entry() {
    awk -v n="  $1:" -v repl="$2" '
        $0 == n { print repl; skip = 1; next }
        skip && /^    / { next }
        { skip = 0; print }' "$REPO/pubspec.lock" > "$WORK/lock.new"
    mv "$WORK/lock.new" "$REPO/pubspec.lock"
    git -C "$REPO" add -A
}

@test "describe is JSON naming dart-lock with needs_tree false; explain prints text" {
    run "$DRIVER" describe
    [ "$status" -eq 0 ]
    [ "$(jq -r '.name' <<<"$output")" = dart-lock ]
    [ "$(jq -r '.needs_tree' <<<"$output")" = false ]
    run "$DRIVER" explain
    [ "$status" -eq 0 ]
    [[ "$output" == *'qg override'* ]]
}

@test "an identical lock and pubspec.yaml measure 0 packages with no findings" {
    measure
    [ "$(result .status)" = measured ]
    [ "$(result .metric)" = 0 ]
    [ "$(result .unit)" = packages ]
    [ "$(result '.findings | length')" = 0 ]
}

@test "a named package's version bump counts 1, and its sha256 changing with it is the same package" {
    edit '/^  lakos:/,/^  [a-z_]*:$/{s/version: "2.0.6"/version: "2.0.7"/;s/8a1d3f7c/0000000c/}'
    measure
    [ "$(result .metric)" = 1 ]
    [ "$(result '.findings[0].ruleId')" = dart-lock.tool-changed ]
    [ "$(result '.findings[0].file')" = pubspec.lock ]
    [[ "$(result '.findings[0].message')" == 'lakos: changed from '*" at $BASE" ]]
}

@test "a named package whose url changes counts 1" {
    edit '/^  dart_code_linter:/,/source:/s#url: "https://pub.dev"#url: "https://mirror.example.invalid"#'
    measure
    [ "$(result .metric)" = 1 ]
    [[ "$(result '.findings[0].message')" == 'dart_code_linter: '* ]]
}

@test "a named git package whose resolved-ref changes counts 1" {
    edit 's/resolved-ref: "5f2c8a1e/resolved-ref: "ffffffff/'
    measure
    [ "$(result .metric)" = 1 ]
    [[ "$(result '.findings[0].message')" == 'mutation_test: '* ]]
}

@test "a named package turned into a path package counts 1, not 2" {
    replace_entry lakos "$(block lakos path 2.0.6 '      path: "../lakos"
      relative: true')"
    measure
    [ "$(result .metric)" = 1 ]
    [ "$(result '.findings | length')" = 1 ]
}

@test "a named package turned into a git package counts 1, not 2" {
    replace_entry dart_code_linter "$(block dart_code_linter git 1.1.5 '      path: "."
      ref: main
      resolved-ref: "1111111111111111111111111111111111111111"
      url: "https://github.com/x/dart_code_linter.git"')"
    measure
    [ "$(result .metric)" = 1 ]
}

@test "two named packages changed count 2, one each" {
    edit 's/version: "2.0.6"/version: "2.0.7"/; s/version: "1.1.5"/version: "1.1.6"/'
    measure
    [ "$(result .metric)" = 2 ]
    [ "$(result '[.findings[].message | split(":")[0]] | sort | join(",")')" = dart_code_linter,lakos ]
}

@test "an unnamed hosted package's version bump counts 0" {
    edit '/^  args:/,/version:/{s/version: "2.7.0"/version: "2.8.0"/;s/d0481093/aaaaaaaa/}'
    measure
    [ "$(result .status)" = measured ]
    [ "$(result .metric)" = 0 ]
}

@test "an unnamed package turned into a path package counts 1" {
    replace_entry args "$(block args path 2.7.0 '      path: "../args"
      relative: true')"
    measure
    [ "$(result .metric)" = 1 ]
    [ "$(result '.findings[0].message')" = 'args: becomes a path package' ]
}

@test "an unnamed package turned into a git package counts 1" {
    replace_entry path "$(block path git 1.9.1 '      path: "."
      ref: main
      resolved-ref: "2222222222222222222222222222222222222222"
      url: "https://github.com/x/path.git"')"
    measure
    [ "$(result .metric)" = 1 ]
    [ "$(result '.findings[0].message')" = 'path: becomes a git package' ]
}

@test "an unnamed package already a path package at the base counts 0 when its path or version changes" {
    edit 's#path: "tool/givore_lints"#path: "tool/other_lints"#; /^  givore_lints:/,/version:/s/version: "1.0.0"/version: "1.1.0"/'
    measure
    [ "$(result .metric)" = 0 ]
}

@test "a named package added or removed counts 1" {
    insert_before givore_lints "$(block flutter_lints hosted 5.0.0)"
    measure
    [ "$(result .metric)" = 1 ]
    [[ "$(result '.findings[0].message')" == 'flutter_lints: added at '* ]]
    git -C "$REPO" checkout -q HEAD -- pubspec.lock
    replace_entry lakos ''
    ! grep -q '^  lakos:' "$REPO/pubspec.lock" || return 1
    measure
    [ "$(result .metric)" = 1 ]
    [ "$(result '.findings[0].message')" = 'lakos: removed' ]
}

@test "an unnamed hosted package added counts 0" {
    insert_before path "$(block meta hosted 1.15.0)"
    measure
    [ "$(result .metric)" = 0 ]
}

@test "a dependency_overrides section added to pubspec.yaml counts 1" {
    printf 'dependency_overrides:\n  lakos: 2.0.7\n' >> "$REPO/pubspec.yaml"
    git -C "$REPO" add -A
    measure
    [ "$(result .metric)" = 1 ]
    [ "$(result '.findings[0].message')" = "pubspec.yaml: dependency_overrides differs from $BASE" ]
}

@test "a quoted \"dependency_overrides\" key counts 1, as the bare key does" {
    printf '"dependency_overrides":\n  lakos: 2.0.7\n' >> "$REPO/pubspec.yaml"
    git -C "$REPO" add -A
    measure
    [ "$(result .metric)" = 1 ]
    git -C "$REPO" checkout -q HEAD -- pubspec.yaml
    printf "'dependency_overrides':\n  lakos: 2.0.7\n" >> "$REPO/pubspec.yaml"
    git -C "$REPO" add -A
    measure
    [ "$(result .metric)" = 1 ]
}

@test "a changed comment inside dependency_overrides counts 0" {
    printf 'dependency_overrides:\n  # pinned for the analyzer\n  path: 1.9.1\n' >> "$REPO/pubspec.yaml"
    ( cd "$REPO" && commit_all overrides )
    export QG_BASES="$(git -C "$REPO" rev-parse HEAD)"
    edit 's/# pinned for the analyzer/# pinned until 2027/' pubspec.yaml
    measure
    [ "$(result .metric)" = 0 ]
}

@test "a column-0 comment inside dependency_overrides does not end the section, so an entry after it counts 1" {
    printf 'dependency_overrides:\n# why\n' >> "$REPO/pubspec.yaml"
    ( cd "$REPO" && commit_all overrides )
    export QG_BASES="$(git -C "$REPO" rev-parse HEAD)"
    printf '  lakos: 2.0.7\n' >> "$REPO/pubspec.yaml"
    git -C "$REPO" add -A
    measure
    [ "$(result .metric)" = 1 ]
}

@test "a pubspec.yaml change outside dependency_overrides counts 0" {
    printf 'flutter:\n  uses-material-design: true\n' >> "$REPO/pubspec.yaml"
    edit 's/^name: givore$/name: givore_app/' pubspec.yaml
    measure
    [ "$(result .metric)" = 0 ]
}

@test "with two bases the metric is the highest count over them, in either order, and the findings come from that base" {
    edit 's/version: "1.1.5"/version: "1.1.6"/'
    ( cd "$REPO" && commit_all bump-dcl )
    local b2
    b2="$(git -C "$REPO" rev-parse HEAD)"
    git -C "$REPO" checkout -q "$BASE" -- pubspec.lock
    edit 's/version: "1.1.5"/version: "1.1.6"/; s/version: "2.0.6"/version: "2.0.7"/'
    export QG_BASES="$BASE $b2"
    measure
    [ "$(result .metric)" = 2 ]
    [ "$(result '.findings | length')" = 2 ]
    [[ "$(result '.findings[0].message')" == *"at $BASE" ]]
    export QG_BASES="$b2 $BASE"
    measure
    [ "$(result .metric)" = 2 ]
    [ "$(result '.findings | length')" = 2 ]
}

@test "a merge carrying a bump one parent already holds counts 1, the count against the other parent" {
    edit 's/version: "2.0.6"/version: "2.0.7"/'
    ( cd "$REPO" && commit_all bump-lakos )
    export QG_BASES="$BASE $(git -C "$REPO" rev-parse HEAD)"
    measure
    [ "$(result .metric)" = 1 ]
}

@test "QG_BASE is read when QG_BASES is unset" {
    edit 's/version: "2.0.6"/version: "2.0.7"/'
    unset QG_BASES
    export QG_BASE="$BASE"
    measure
    [ "$(result .status)" = measured ]
    [ "$(result .metric)" = 1 ]
}

@test "a commit QG_TARGET reads that commit, never the index or the working tree" {
    edit 's/version: "2.0.6"/version: "2.0.7"/'
    ( cd "$REPO" && commit_all bump-lakos )
    export QG_TARGET="$(git -C "$REPO" rev-parse HEAD)"
    edit 's/version: "2.0.7"/version: "2.0.6"/'
    sed -i 's/version: "1.1.5"/version: "9.9.9"/' "$REPO/pubspec.lock"
    measure
    [ "$(result .metric)" = 1 ]
    [[ "$(result '.findings[0].message')" == 'lakos: '* ]]
}

@test "under :index an unstaged working-tree edit is not read" {
    sed -i 's/version: "2.0.6"/version: "2.0.7"/' "$REPO/pubspec.lock"
    measure
    [ "$(result .metric)" = 0 ]
}

@test "lock= reads that lock and the pubspec.yaml beside it" {
    mkdir -p "$REPO/app"
    printf '%s' "$LOCK" > "$REPO/app/pubspec.lock"
    printf '%s' "$SPEC" > "$REPO/app/pubspec.yaml"
    ( cd "$REPO" && commit_all app )
    export QG_BASES="$(git -C "$REPO" rev-parse HEAD)" QG_ARGS="$NAMED lock=app/pubspec.lock"
    printf 'dependency_overrides:\n  path: 1.9.0\n' >> "$REPO/app/pubspec.yaml"
    edit 's/version: "2.0.6"/version: "2.0.7"/' app/pubspec.lock
    measure
    [ "$(result .metric)" = 2 ]
    [ "$(result '[.findings[].file] | unique | join(",")')" = app/pubspec.lock ]
    [[ "$(result '.findings[1].message')" == 'app/pubspec.yaml: dependency_overrides differs'* ]]
}

@test "a lock missing in the measured commit is status error with metric null" {
    git -C "$REPO" rm -q --cached pubspec.lock
    measure
    [ "$(result .status)" = error ]
    [ "$(result .metric)" = null ]
    [[ "$(result .error)" == *'pubspec.lock is missing in the measured commit'* ]]
}

@test "a lock missing at a base is status error naming that base" {
    git -C "$REPO" rm -q pubspec.lock
    ( cd "$REPO" && commit_all no-lock )
    local nolock
    nolock="$(git -C "$REPO" rev-parse HEAD)"
    git -C "$REPO" checkout -q "$BASE" -- pubspec.lock
    export QG_BASES="$BASE $nolock"
    measure
    [ "$(result .status)" = error ]
    [ "$(result .metric)" = null ]
    [[ "$(result .error)" == *"missing at base ${nolock}"* ]]
}

@test "an empty QG_BASES is status error, never a measured 0" {
    export QG_BASES='  '
    measure
    [ "$(result .status)" = error ]
    [ "$(result .metric)" = null ]
    [[ "$(result .error)" == *'no base'* ]]
    unset QG_BASES
    measure
    [ "$(result .status)" = error ]
}

@test "a missing packages= is status error naming packages=" {
    export QG_ARGS='lock=pubspec.lock'
    measure
    [ "$(result .status)" = error ]
    [ "$(result .metric)" = null ]
    [[ "$(result .error)" == *'packages='* ]]
}

@test "a flow-style entry in the measured lock is status error, not a count" {
    replace_entry lakos '  lakos: {dependency: "direct dev", source: hosted, version: "2.0.7"}'
    measure
    [ "$(result .status)" = error ]
    [ "$(result .metric)" = null ]
    [[ "$(result .error)" == *"not in pub's block form"*'lakos: {'* ]]
}

@test "a flow-style entry in a base lock is status error naming the base" {
    replace_entry args '  args: {source: hosted, version: "2.7.0"}'
    ( cd "$REPO" && commit_all flow )
    export QG_BASES="$(git -C "$REPO" rev-parse HEAD)"
    git -C "$REPO" checkout -q "$BASE" -- pubspec.lock
    measure
    [ "$(result .status)" = error ]
    [[ "$(result .error)" == *"at ${QG_BASES} is not in pub's block form"* ]]
}

@test "an entry with no source line is status error" {
    edit '/^  lakos:/,/version:/{/source: hosted/d}'
    measure
    [ "$(result .status)" = error ]
    [[ "$(result .error)" == *'lakos has no source'* ]]
}
